# Required for the support chat widget (bottom-right bubble) to work.
# Copy this file to .env.local and fill in a real key, then restart `npm run dev`.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Enables WalletConnect (QR-code / deep-link connect) in the wallet modal, which
# is how mobile-only wallets — Robinhood, Trust mobile, etc. — connect, since they have no
# browser extension to auto-detect. Get a free project ID at https://cloud.reown.com and
# restart `npm run dev`. Every browser-extension wallet (Phantom, Solflare, Backpack,
# Coinbase Wallet, Glow, OKX, ...) already auto-detects without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC endpoint the app talks to for on-chain reads/writes (curve trades, treasury). Defaults
# to a local validator (http://127.0.0.1:8899) if unset. Point this at devnet to use the
# deployed alloy_curve program there.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional, comma-separated backup RPC endpoints (e.g. a second provider on the same network).
# getConnection() (lib/onchain/program.ts) health-checks the primary URL above and fails over
# to the first responsive one in this list if it's down, re-checking at most every 30s. Without
# this set, an outage on the primary RPC provider takes down every on-chain read/write in the
# app with no recourse.
NEXT_PUBLIC_SOLANA_RPC_FALLBACK_URLS=

# Optional, comma-separated wallet ids. Gates the app's own off-chain admin screens
# (verification approvals, feedback resolution) independent of who holds on-chain treasury
# fund authority — see lib/admin.ts's isAppAdmin. Without this set, those screens fall back
# to "on-chain treasury admin = app admin" (today's default), which stops working the
# moment treasury admin migrates to a multisig vault PDA (no one can sign in as a PDA).
# Set this BEFORE that migration so admin access to these screens survives it.
ADMIN_WALLET_IDS=

# Encrypts phone/email contacts and verification codes at rest in the SQLite DB (AES-256-GCM,
# see lib/pii.ts). Without this set, a public dev-only fallback key is used and a warning is
# logged — fine for local dev, NOT safe for any real deployment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set this BEFORE any real verification data is written — rotating it after the fact makes
# existing encrypted rows undecryptable.
PII_ENCRYPTION_KEY=

# Optional. Sends real SMS verification codes via Twilio instead of echoing the code back
# in the API response (see lib/notifications.ts). Get these from console.twilio.com — you
# need an account, a purchased/verified sending number, and (for trial accounts) the
# recipient number verified too. Without these set, phone verification stays simulated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional. Sends real email verification codes via Resend instead of echoing the code
# back. Get an API key at resend.com; EMAIL_FROM must be an address on a domain you've
# verified with Resend (their onboarding walks through the DNS records). Without these
# set, email verification stays simulated.
RESEND_API_KEY=
EMAIL_FROM=
